[node name="IntroLabel" type="Label" parent="CenterPanel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Guide the walkers to the green exit.\nUse Blocker to turn the crowd around.\nUse Builder to place bridges over gaps.\nUse Digger to break weak terrain.\nUse Parachute to survive long drops.\nUse Climber to climb up high walls.\nRescue enough walkers before time runs out."
horizontal_alignment = 1

[node name="HintLabel" type="Label" parent="CenterPanel/Content"]
